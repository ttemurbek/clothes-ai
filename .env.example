# Copy to .env (never commit .env). Production values go into the hosting environment.
APP_ENV=development
PORT=5000
FLASK_DEBUG=0
# SECRET_KEY=long-random-string            # required when APP_ENV=production
# PUBLIC_URL=https://clothes-ai.example.uz # needed for the Telegram bot and Mini App
# DATA_DIR=/data                           # SQLite db + product photos + private try-on files
# DATABASE_URL=postgresql://...            # optional, instead of SQLite
SEED_DEMO=1
# DEMO_SELLER_PASSWORD=                     # set to create demo@clothes.ai for the first demo shop

# Reservations
RESERVATION_CONFIRM_HOURS=3
RESERVATION_HOLD_HOURS=24

# Virtual try-on: none | demo (local UI testing, no AI) | http (licensed provider)
TRYON_PROVIDER=none
# TRYON_API_URL=
# TRYON_API_KEY=
PHOTO_RETENTION_HOURS=24
TRYON_DAILY_LIMIT=10

# AI photographer for shops: none | rembg (pip install rembg) | http
PHOTO_PROVIDER=none
# PHOTO_API_URL=
# PHOTO_API_KEY=

# AI stylist: rules (offline, default without a key) | anthropic (Claude picks the outfit and explains it)
# ANTHROPIC_API_KEY=
# STYLIST_PROVIDER=anthropic
STYLIST_MODEL=claude-opus-5-5
STYLIST_EFFORT=low
STYLIST_TIMEOUT=45

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
